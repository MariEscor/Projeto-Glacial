  npcName: ROGERIO
  npcPortrait: {fileID: 1611970466183296693, guid: fc5c38a125636f44aa6b4888ae093c5c, type: 3}
  dialogueLines:
  - "Voc\xEA conseguiu! Obrigado por ajudar a proteger nosso lar."
  - "Hoje voc\xEA aprendeu sobre: efeito estufa, aquecimento global, sustentabilidade,
    reciclagem, e preserva\xE7\xE3o ambiental."
  - "O planeta precisa da ajuda de todos n\xF3s. Pequenas atitudes podem causar grandes
    mudan\xE7as."
  - "Economizar energia, reciclar, evitar polui\xE7\xE3o, e cuidar da natureza s\xE3o
    formas de proteger os animais e o planeta."
  - "Nunca se esque\xE7a: cuidar da Terra tamb\xE9m \xE9 cuidar do nosso futuro."
  autoProgressLines: 0101010101
  endDialogueLines: 0000000000
